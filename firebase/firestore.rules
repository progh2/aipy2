rules_version = '2';
// 정적 호스팅에는 비밀이 없으므로, 학교 도메인 확인과 반·번호 위조 방지는 모두 이 규칙이 담당합니다.
// 콘솔 → Firestore Database → 규칙에 붙여넣고 게시하거나, firebase deploy --only firestore:rules 로 배포합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth.token.email.lower();
    }

    // 학교 Google 계정만 데이터에 접근합니다. 개인 계정은 로그인은 되어도 아무것도 읽고 쓸 수 없습니다.
    function schoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@e-mirim[.]hs[.]kr$');
    }

    // 교사 권한은 콘솔에서 admins/{학교이메일} 문서를 만들어 부여합니다.
    function isTeacher() {
      return schoolAccount()
        && exists(/databases/$(database)/documents/admins/$(email()));
    }

    function rosterPath() {
      return /databases/$(database)/documents/roster/$(email());
    }

    function listed() {
      return exists(rosterPath());
    }

    // 학생은 자기 학번·입학년도·학년·반·번호를 스스로 정하지 못하고, 교사가 등록한 명단 값만 쓸 수 있습니다.
    // 명단 문서는 인자로 한 번만 넘겨 받습니다. get()은 읽기로 과금되고 호출 횟수 제한도 있습니다.
    function copiedFrom(entry) {
      return request.resource.data.studentId == entry.studentId
        && request.resource.data.admissionYear == entry.admissionYear
        && request.resource.data.grade == entry.grade
        && request.resource.data.classroom == entry.classroom
        // number(출석번호)는 선택 항목이라 없을 수도 있습니다. 없는 필드를 직접 읽으면 규칙이 오류로 거부됩니다.
        && request.resource.data.get('number', null) == entry.get('number', null);
    }

    function unassigned() {
      return request.resource.data.studentId == null
        && request.resource.data.admissionYear == null
        && request.resource.data.grade == null
        && request.resource.data.classroom == null
        && request.resource.data.get('number', null) == null;
    }

    function matchesRoster() {
      return listed() ? copiedFrom(get(rosterPath()).data) : unassigned();
    }

    function owns(uid) {
      return request.auth != null && request.auth.uid == uid && schoolAccount();
    }

    // 교사가 미리 등록하는 명단. 학생은 자기 한 줄만 읽습니다.
    match /roster/{rosterEmail} {
      allow get: if schoolAccount() && rosterEmail == email();
      allow get, list: if isTeacher();
      // delete 는 request.resource 가 없으므로 검증식과 분리합니다.
      allow delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'updatedAt'])
        && request.resource.data.email == rosterEmail
        && request.resource.data.name is string
        // 학번은 앞자리 0이 지워지지 않도록 문자열로 저장합니다.
        && request.resource.data.studentId is string
        && request.resource.data.admissionYear is int
        && request.resource.data.grade is int
        && request.resource.data.classroom is int;
    }

    // 교사 계정 목록. 콘솔에서만 추가·삭제합니다.
    match /admins/{adminEmail} {
      allow get: if schoolAccount() && adminEmail == email();
      allow list, write: if false;
    }

    match /students/{uid} {
      allow get: if owns(uid);
      allow get, list: if isTeacher();
      allow delete: if isTeacher();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'updatedAt'])
        && matchesRoster();

      // 학습 기록 미러: 브라우저 localStorage의 state를 그대로 담습니다. (다음 단계)
      match /state/{docId} {
        allow read, write: if owns(uid);
        allow read: if isTeacher();
      }

      // 과제 제출물: 소스·입력·채점 결과·출력을 함께 남깁니다. (다음 단계)
      match /submissions/{taskId} {
        allow read, create, update: if owns(uid);
        allow read: if isTeacher();
        allow delete: if isTeacher();
      }
    }

    // 반별 집계용 요약. 교사 관리 페이지는 이 컬렉션만 조회합니다. (다음 단계)
    match /progress/{uid} {
      allow get: if owns(uid);
      allow get, list: if isTeacher();
      allow create, update: if owns(uid)
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'counts', 'understanding', 'updatedAt'])
        && matchesRoster();
    }

    function rosterClassId() {
      return listed()
        ? string(get(rosterPath()).data.grade) + '-' + string(get(rosterPath()).data.classroom)
        : '';
    }

    function classIdOk(id) {
      return id is string && id.matches('^[0-9]+-[0-9]+$');
    }

    function optionalShort(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function sessionFocusOk() {
      return request.resource.data.focus.keys().hasOnly(['page', 'topicAnchor', 'exampleId', 'updatedAt'])
        && request.resource.data.focus.page is string
        && request.resource.data.focus.page.size() > 0
        && request.resource.data.focus.page.size() <= 200
        && optionalShort(request.resource.data.focus.topicAnchor, 80)
        && optionalShort(request.resource.data.focus.exampleId, 80)
        && request.resource.data.focus.updatedAt is timestamp;
    }

    // JS SDK는 0 같은 정수를 double로 보내는 경우가 많습니다. `is int`만 쓰면
    // 세션 생성·increment 갱신이 permission-denied가 됩니다. 정수와 같은 실수만 허용합니다.
    function wholeNumber(value) {
      return (value is int || value is float) && value == int(value);
    }

    function sessionAttentionOk() {
      return request.resource.data.attention.keys().hasOnly(['nonce', 'at'])
        && wholeNumber(request.resource.data.attention.nonce)
        && request.resource.data.attention.nonce >= 0
        && request.resource.data.attention.at is timestamp
        && (!resource.exists || request.resource.data.attention.nonce >= resource.data.attention.nonce);
    }

    // 수업 세션. 문서 ID는 `{학년}-{반}` (예: 2-3). 학생은 자기 반 문서만 읽고 쓰지 못합니다.
    match /sessions/{classroom} {
      allow get: if schoolAccount() && classIdOk(classroom) && classroom == rosterClassId();
      allow get, list: if isTeacher();
      allow create, update: if isTeacher()
        && classIdOk(classroom)
        && request.resource.data.keys().hasOnly(['active', 'teacherEmail', 'startedAt', 'expiresAt', 'focus', 'attention'])
        && request.resource.data.active is bool
        && request.resource.data.teacherEmail is string
        && request.resource.data.teacherEmail.size() <= 80
        && request.resource.data.startedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && sessionFocusOk()
        && sessionAttentionOk();
      allow delete: if isTeacher();
    }

    // 접속·따라가기 상태. 학생은 자기 문서만 쓰고, 반은 명단 값과 같아야 합니다.
    match /presence/{uid} {
      allow get: if owns(uid);
      allow get, list: if isTeacher();
      allow delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['classroom', 'page', 'topicAnchor', 'following', 'updatedAt'])
        && classIdOk(request.resource.data.classroom)
        && request.resource.data.classroom == rosterClassId()
        && request.resource.data.following is bool
        && optionalShort(request.resource.data.page, 200)
        && optionalShort(request.resource.data.topicAnchor, 80)
        && request.resource.data.updatedAt is timestamp;
    }
  }
}
