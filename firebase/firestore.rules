rules_version = '2';
// 정적 호스팅에는 비밀이 없으므로, 학교 도메인 확인과 반·번호 위조 방지는 모두 이 규칙이 담당합니다.
// 콘솔 → Firestore Database → 규칙에 붙여넣고 게시하거나, firebase deploy --only firestore:rules 로 배포합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth.token.email.lower();
    }

    // 학교 Google 계정만 데이터에 접근합니다. 개인 계정은 로그인은 되어도 아무것도 읽고 쓸 수 없습니다.
    function schoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[a-z0-9._%+-]+@e-mirim[.]hs[.]kr$');
    }

    // 교사 권한은 콘솔에서 admins/{학교이메일} 문서를 만들어 부여합니다.
    function isTeacher() {
      return schoolAccount()
        && exists(/databases/$(database)/documents/admins/$(email()));
    }

    function rosterPath() {
      return /databases/$(database)/documents/roster/$(email());
    }

    function listed() {
      return exists(rosterPath());
    }

    // 학생은 자기 학번·입학년도·학년·반·번호를 스스로 정하지 못하고, 교사가 등록한 명단 값만 쓸 수 있습니다.
    // 명단 문서는 인자로 한 번만 넘겨 받습니다. get()은 읽기로 과금되고 호출 횟수 제한도 있습니다.
    function copiedFrom(entry) {
      return request.resource.data.studentId == entry.studentId
        && request.resource.data.admissionYear == entry.admissionYear
        && request.resource.data.grade == entry.grade
        && request.resource.data.classroom == entry.classroom
        // number(출석번호)는 선택 항목이라 없을 수도 있습니다. 없는 필드를 직접 읽으면 규칙이 오류로 거부됩니다.
        && request.resource.data.get('number', null) == entry.get('number', null);
    }

    function unassigned() {
      return request.resource.data.studentId == null
        && request.resource.data.admissionYear == null
        && request.resource.data.grade == null
        && request.resource.data.classroom == null
        && request.resource.data.get('number', null) == null;
    }

    function matchesRoster() {
      return listed() ? copiedFrom(get(rosterPath()).data) : unassigned();
    }

    function owns(uid) {
      return request.auth != null && request.auth.uid == uid && schoolAccount();
    }

    // 진급 때 교사가 학년·반만 맞춥니다. 입학년도·이메일·학번은 바꾸지 못합니다.
    function teacherIdentityPatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['grade', 'classroom', 'number', 'updatedAt'])
        && request.resource.data.grade is int
        && request.resource.data.classroom is int
        && request.resource.data.admissionYear == resource.data.admissionYear
        && request.resource.data.email == resource.data.email
        && request.resource.data.studentId == resource.data.studentId;
    }

    // 교사가 미리 등록하는 명단. 학생은 자기 한 줄만 읽습니다.
    // archived 는 졸업 코호트 보관 표시입니다. 학습 기록 삭제와 무관합니다.
    match /roster/{rosterEmail} {
      allow get: if schoolAccount() && rosterEmail == email();
      allow get, list: if isTeacher();
      // delete 는 request.resource 가 없으므로 검증식과 분리합니다.
      allow delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'updatedAt', 'archived', 'archivedAt'])
        && request.resource.data.email == rosterEmail
        && request.resource.data.name is string
        // 학번은 앞자리 0이 지워지지 않도록 문자열로 저장합니다.
        && request.resource.data.studentId is string
        && request.resource.data.admissionYear is int
        && request.resource.data.grade is int
        && request.resource.data.classroom is int
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp);
    }

    // 교사 계정 목록. 콘솔에서만 추가·삭제합니다.
    match /admins/{adminEmail} {
      allow get: if schoolAccount() && adminEmail == email();
      allow list, write: if false;
    }

    match /students/{uid} {
      allow get: if owns(uid);
      allow get, list: if isTeacher();
      allow delete: if isTeacher();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'updatedAt'])
        && matchesRoster();
      // 진급 일괄 반영. 입학년도는 유지하고 학년·반만 고칩니다.
      allow update: if isTeacher() && teacherIdentityPatch();

      // 학습 기록 미러: localStorage의 complete/answers/journals/projects(+ last)를 그대로 담습니다.
      // 항목별 시각은 times, 문서 시각은 updatedAt. 키 제한을 두지 않아 문항·주제가 늘어도 규칙을 고치지 않습니다.
      match /state/{docId} {
        allow read, write: if owns(uid);
        allow read: if isTeacher();
      }

      // 과제 제출물: 소스·입력·채점 결과·출력을 함께 남깁니다. 교사는 확인·코멘트만 고칩니다.
      match /submissions/{taskId} {
        allow get: if owns(uid);
        allow get, list: if isTeacher();
        allow list: if owns(uid);
        allow create: if owns(uid) && submissionCreateOk(taskId);
        allow update: if owns(uid) && submissionUpdateOk(taskId);
        allow update: if isTeacher() && teacherReviewPatch();
        allow delete: if isTeacher();
      }
    }

    // 이해도 맵은 키가 주제마다 늘어나므로 값마다 나열하지 않고, 맵·개수만 제한합니다.
    function understandingOk(value) {
      return value is map && value.size() <= 80;
    }

    // 반별 집계용 요약. 학생 쓰기는 아래 키만 허용합니다. understanding은 짧은 문자열 맵입니다.
    match /progress/{uid} {
      allow get: if owns(uid);
      allow get, list: if isTeacher();
      allow create, update: if owns(uid)
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'counts', 'understanding', 'updatedAt'])
        && understandingOk(request.resource.data.understanding)
        && matchesRoster();
      allow update: if isTeacher() && teacherIdentityPatch();
    }

    function rosterClassId() {
      return listed()
        ? string(get(rosterPath()).data.grade) + '-' + string(get(rosterPath()).data.classroom)
        : '';
    }

    function classIdOk(id) {
      return id is string && id.matches('^[0-9]+-[0-9]+$');
    }

    function optionalShort(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function sessionFocusOk() {
      return request.resource.data.focus is map
        && request.resource.data.focus.keys().hasOnly(['page', 'topicAnchor', 'exampleId', 'updatedAt'])
        && request.resource.data.focus.page is string
        && request.resource.data.focus.page.size() > 0
        && request.resource.data.focus.page.size() <= 200
        // 없는 필드를 직접 읽으면 규칙이 오류로 거부됩니다. 주제·예제는 비울 수 있습니다.
        && optionalShort(request.resource.data.focus.get('topicAnchor', null), 80)
        && optionalShort(request.resource.data.focus.get('exampleId', null), 80)
        && request.resource.data.focus.updatedAt is timestamp;
    }

    // JS SDK는 0 같은 정수를 double로 보내는 경우가 많습니다. `is int`만 쓰면
    // 세션 생성·increment 갱신이 permission-denied가 됩니다. 정수와 같은 실수만 허용합니다.
    function wholeNumber(value) {
      return (value is int || value is float) && value == int(value);
    }

    // create 경로에서는 resource.data.attention 을 읽지 않습니다.
    function sessionAttentionOk() {
      return request.resource.data.attention is map
        && request.resource.data.attention.keys().hasOnly(['nonce', 'at'])
        && wholeNumber(request.resource.data.attention.nonce)
        && request.resource.data.attention.nonce >= 0
        && request.resource.data.attention.at is timestamp;
    }

    function sessionNonceMonotonic() {
      return request.resource.data.attention.nonce >= resource.data.attention.nonce;
    }

    // 같은 세션에서 시선 nonce를 되돌리면 학생 쪽 안내가 어긋납니다.
    // 다만 교사가 세션을 다시 시작할 때(startedAt이 바뀌고 active가 true)는
    // nonce를 0으로 초기화해도 됩니다. 학생은 sessions에 쓰지 못합니다.
    function sessionRestart() {
      return request.resource.data.active == true
        && request.resource.data.startedAt != resource.data.get('startedAt', request.resource.data.startedAt);
    }

    function sessionPayloadOk() {
      return request.resource.data.keys().hasOnly(['active', 'teacherEmail', 'startedAt', 'expiresAt', 'focus', 'attention'])
        && request.resource.data.active is bool
        && request.resource.data.teacherEmail is string
        && request.resource.data.teacherEmail.size() <= 80
        && request.resource.data.startedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && sessionFocusOk()
        && sessionAttentionOk();
    }

    // 수업 세션. 문서 ID는 `{학년}-{반}` (예: 2-3). 학생은 자기 반 문서만 읽고 쓰지 못합니다.
    // create 와 update 를 나눕니다. nonce 단조성은 기존 문서가 있는 update 에서만 검사하고,
    // 교사가 startedAt을 바꿔 다시 시작할 때는 nonce를 초기화할 수 있습니다.
    match /sessions/{classroom} {
      allow get: if schoolAccount() && classIdOk(classroom) && classroom == rosterClassId();
      allow get, list: if isTeacher();
      allow create: if isTeacher() && classIdOk(classroom) && sessionPayloadOk();
      allow update: if isTeacher() && classIdOk(classroom) && sessionPayloadOk()
        && (sessionNonceMonotonic() || sessionRestart());
      allow delete: if isTeacher();
    }

    // 접속·따라가기 상태. 학생은 자기 문서만 쓰고, 반은 명단 값과 같아야 합니다.
    match /presence/{uid} {
      allow get: if owns(uid);
      allow get, list: if isTeacher();
      allow delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['classroom', 'page', 'topicAnchor', 'following', 'updatedAt'])
        && classIdOk(request.resource.data.classroom)
        && request.resource.data.classroom == rosterClassId()
        && request.resource.data.following is bool
        && optionalShort(request.resource.data.page, 200)
        && optionalShort(request.resource.data.topicAnchor, 80)
        && request.resource.data.updatedAt is timestamp;
    }

    function helpIdentityOk() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && matchesRoster();
    }

    function optionalTopic(value) {
      return value == null || (value is string && value.matches('^u[1-4]-[a-z0-9-]+$') && value.size() <= 40);
    }

    // create 에서는 resource 를 읽지 않습니다. 상태 변경만 update 에서 검사합니다.
    function helpCreateOk() {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'classId', 'topic', 'example', 'lastError', 'status', 'createdAt', 'updatedAt'])
        && helpIdentityOk()
        && request.resource.data.classId is string
        && classIdOk(request.resource.data.classId)
        && request.resource.data.classId == rosterClassId()
        && request.resource.data.status == 'open'
        && optionalTopic(request.resource.data.get('topic', null))
        && optionalShort(request.resource.data.get('example', null), 80)
        && optionalShort(request.resource.data.get('lastError', null), 300)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function helpStatusPatch(next) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status == 'open'
        && request.resource.data.status == next
        && request.resource.data.updatedAt is timestamp;
    }

    match /helpRequests/{id} {
      allow get: if schoolAccount() && resource.data.uid == request.auth.uid;
      allow get, list: if isTeacher();
      allow list: if schoolAccount() && resource.data.uid == request.auth.uid;
      allow create: if schoolAccount() && helpCreateOk();
      allow update: if schoolAccount() && request.auth.uid == resource.data.uid && helpStatusPatch('cancelled');
      allow update: if isTeacher() && helpStatusPatch('resolved');
    }

    function feedbackPayloadOk() {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'topicId', 'text', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.topicId is string
        && request.resource.data.topicId.matches('^u[1-4]-[a-z0-9-]+$')
        && request.resource.data.topicId.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && matchesRoster();
    }

    match /feedback/{id} {
      allow get: if schoolAccount() && resource.data.uid == request.auth.uid;
      allow get, list: if isTeacher();
      allow create: if schoolAccount()
        && feedbackPayloadOk()
        && id == request.auth.uid + '_' + request.resource.data.topicId;
      allow update: if schoolAccount()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.topicId == resource.data.topicId
        && feedbackPayloadOk();
    }

    function submissionIdentityOk() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && matchesRoster();
    }

    function submissionCoreOk(taskId) {
      return request.resource.data.keys().hasOnly(['assignmentId', 'uid', 'email', 'studentId', 'admissionYear', 'name', 'grade', 'classroom', 'number', 'classId', 'status', 'late', 'submittedAt', 'attemptCount', 'targets', 'history', 'reviewStatus', 'reviewComment', 'reviewedAt', 'reviewedBy', 'updatedAt'])
        && submissionIdentityOk()
        && request.resource.data.assignmentId == taskId
        && request.resource.data.classId is string
        && classIdOk(request.resource.data.classId)
        && request.resource.data.classId == rosterClassId()
        && request.resource.data.status in ['passed', 'failed']
        && request.resource.data.late is bool
        && wholeNumber(request.resource.data.attemptCount)
        && request.resource.data.attemptCount >= 1
        && request.resource.data.attemptCount <= 40
        && request.resource.data.targets is map
        && request.resource.data.targets.size() > 0
        && request.resource.data.targets.size() <= 40
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 12
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.reviewComment is string
        && request.resource.data.reviewComment.size() <= 80
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.get('reviewedAt', null) == null || request.resource.data.reviewedAt is timestamp)
        && optionalShort(request.resource.data.get('reviewedBy', null), 80);
    }

    function submissionCreateOk(taskId) {
      return submissionCoreOk(taskId)
        && request.resource.data.attemptCount == 1
        && request.resource.data.reviewComment == ''
        && request.resource.data.get('reviewedAt', null) == null
        && request.resource.data.get('reviewedBy', null) == null;
    }

    function submissionUpdateOk(taskId) {
      return submissionCoreOk(taskId)
        && request.resource.data.attemptCount == resource.data.attemptCount + 1
        && request.resource.data.reviewComment == resource.data.reviewComment
        && request.resource.data.get('reviewedBy', null) == resource.data.get('reviewedBy', null)
        && request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null);
    }

    function teacherReviewPatch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus', 'reviewComment', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.reviewStatus == 'reviewed'
        && request.resource.data.reviewComment is string
        && request.resource.data.reviewComment.size() <= 80
        && request.resource.data.reviewedBy == email()
        && request.resource.data.reviewedAt is timestamp;
    }

    function assignmentWriteOk() {
      return request.resource.data.keys().hasOnly(['title', 'description', 'targets', 'classrooms', 'openAt', 'dueAt', 'open', 'createdAt', 'updatedAt', 'createdBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.targets is list
        && request.resource.data.targets.size() > 0
        && request.resource.data.targets.size() <= 40
        && request.resource.data.classrooms is list
        && request.resource.data.classrooms.size() > 0
        && request.resource.data.classrooms.size() <= 20
        && request.resource.data.open is bool
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdBy.size() <= 80
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.openAt == null || request.resource.data.openAt is timestamp)
        && (request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp);
    }

    // 과제 정의. 학생은 자기 반에 공개된 과제만 읽고, 교사가 만들고 고칩니다.
    match /assignments/{id} {
      allow get, list: if isTeacher();
      allow get, list: if schoolAccount()
        && resource.data.open == true
        && resource.data.classrooms.hasAny([rosterClassId()]);
      allow create: if isTeacher() && assignmentWriteOk();
      allow update: if isTeacher() && assignmentWriteOk()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isTeacher();
    }
  }
}
